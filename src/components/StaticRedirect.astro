---
interface Props {
  destination: string;
}

const { destination } = Astro.props;
const canonicalURL = new URL(destination, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050505" />
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <link rel="canonical" href={canonicalURL} />
    <title>Redirecting…</title>
    <script is:inline define:vars={{ destination }}>
      try {
        localStorage.setItem('geminikim.locale', 'en');
      } catch {
        // The redirect still works when storage is unavailable.
      }
      window.location.replace(destination);
    </script>
    <style is:inline>
      html { color-scheme: dark; background: #050505; }
      body { color: #f5f5f5; font-family: system-ui, sans-serif; }
      a { color: #d7ff64; }
    </style>
  </head>
  <body>
    <p><a href={destination}>Continue to the English page</a></p>
  </body>
</html>
