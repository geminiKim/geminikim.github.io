---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale, LocaleLinks } from '../i18n/config';
import { localePath, ui } from '../i18n/config';
import '../styles/global.css';

interface Props {
  title?: string;
  ogTitle?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  locale: Locale;
  alternates?: LocaleLinks;
  isHome?: boolean;
}

const {
  title,
  ogTitle,
  description,
  type = 'website',
  publishedAt,
  updatedAt,
  locale,
  alternates = {},
  isHome = false,
} = Astro.props;
const defaultDescription =
  locale === 'ko'
    ? '소프트웨어를 만들고 운영하며 배운 것을 기록하는 Gemini Kim의 블로그입니다.'
    : 'Gemini Kim writes about building, operating, and learning from software.';
const pageDescription = description ?? defaultDescription;
const siteName = 'Gemini Kim';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — Software engineering notes`;
const socialTitle = ogTitle ?? pageTitle;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const alternateEntries = Object.entries(alternates) as [Locale, string][];
const absoluteURL = (path: string) => new URL(path, Astro.site ?? Astro.url.origin);
const ogLocale = locale === 'ko' ? 'ko_KR' : 'en_US';
const alternateOgLocale = locale === 'ko' ? 'en_US' : 'ko_KR';
const text = ui[locale];
const koHome = localePath('ko');
const enHome = localePath('en');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`Gemini Kim RSS (${locale})`} href={localePath(locale, 'rss.xml')} />
    <link rel="canonical" href={canonicalURL} />
    {alternateEntries.map(([lang, path]) => (
      <link rel="alternate" hreflang={lang} href={absoluteURL(path)} />
    ))}
    {alternates.en && <link rel="alternate" hreflang="x-default" href={absoluteURL(alternates.en)} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
    <title>{pageTitle}</title>
    {isHome && (
      <script is:inline define:vars={{ locale, koHome, enHome }}>
        (() => {
          try {
            const saved = localStorage.getItem('geminikim.locale');
            let preferred = saved === 'ko' || saved === 'en' ? saved : null;
            if (!preferred && locale === 'en') {
              const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
              preferred = languages.some((language) => language.toLowerCase().startsWith('ko')) ? 'ko' : 'en';
            }
            if (preferred && preferred !== locale) {
              location.replace(preferred === 'ko' ? koHome : enHome);
            }
          } catch {
            // Keep the requested page when browser storage or language APIs are unavailable.
          }
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{text.skip}</a>
    <Header locale={locale} alternates={alternates} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
