---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getVisiblePosts } from '../../lib/posts';

const posts = await getVisiblePosts('en');
const alternates = { en: '/articles/', ko: '/ko/articles/' };
---

<BaseLayout
  title="Articles"
  description="Articles and notes by Gemini Kim."
  locale="en"
  alternates={alternates}
>
  <section class="page-header page-shell">
    <h1>Articles</h1>
    <p>Notes, essays, and observations.</p>
  </section>
  <section class="archive page-shell" aria-label="All articles">
    <PostList posts={posts} locale="en" />
  </section>
</BaseLayout>
