---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getVisiblePosts } from '../../../lib/posts';

const posts = await getVisiblePosts('ko');
const alternates = { en: '/articles/', ko: '/ko/articles/' };
---

<BaseLayout
  title="글"
  ogTitle="Articles — Gemini Kim"
  description="Gemini Kim이 소프트웨어 개발과 운영에서 배운 것을 기록한 글입니다."
  locale="ko"
  alternates={alternates}
>
  <section class="page-header page-shell">
    <p class="section-kicker">Articles</p>
    <h1>글</h1>
    <p>문제를 바라본 방식, 선택의 근거, 그리고 운영 뒤에 남은 배움을 기록합니다.</p>
  </section>
  <section class="archive page-shell" aria-label="전체 글">
    <PostList posts={posts} locale="ko" />
  </section>
</BaseLayout>
