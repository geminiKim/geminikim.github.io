---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getVisiblePosts } from '../../../lib/posts';

const posts = await getVisiblePosts('ko');
const alternates = { en: '/articles/', ko: '/ko/articles/' };
---

<BaseLayout
  title="Articles"
  description="Gemini Kim의 생각과 경험을 기록한 글을 모았습니다."
  locale="ko"
  alternates={alternates}
>
  <section class="page-header page-shell">
    <h1>Articles</h1>
    <p>생각과 경험을 기록합니다.</p>
  </section>
  <section class="archive page-shell" aria-label="전체 글">
    <PostList posts={posts} locale="ko" />
  </section>
</BaseLayout>
