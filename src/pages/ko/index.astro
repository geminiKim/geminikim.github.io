---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getVisiblePosts } from '../../lib/posts';
import { homeStructuredData } from '../../lib/structuredData';

const posts = (await getVisiblePosts('ko')).slice(0, 5);
const alternates = { en: '/', ko: '/ko/' };
---

<BaseLayout locale="ko" alternates={alternates} isHome structuredData={homeStructuredData('ko')}>
  <section class="hero page-shell">
    <p class="eyebrow"><span aria-hidden="true"></span> Engineer · Writer</p>
    <h1>Build it. Run it.<br /><em>Learn</em> from it.</h1>
    <p class="hero-description">
      안녕하세요, Gemini Kim입니다. 소프트웨어의 문제를 정의하고 단순한 해법을 실험하며,
      실제 운영에서 얻은 배움을 기록합니다.
    </p>
    <div class="hero-actions">
      <a class="button primary" href="/ko/articles/">글 둘러보기 <span aria-hidden="true">→</span></a>
      <a class="button secondary" href="/ko/about/">소개</a>
    </div>
  </section>

  <section class="latest page-shell" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Latest articles</p>
        <h2 id="latest-title">최근 글</h2>
      </div>
      <a href="/ko/articles/">모든 글 <span aria-hidden="true">→</span></a>
    </div>
    <PostList posts={posts} locale="ko" />
  </section>
</BaseLayout>
