---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { topics } from '../../../data/tag-taxonomy.mjs';
import { getPostsForTopic, getVisiblePosts } from '../../../lib/posts';

const posts = await getVisiblePosts('ko');
const alternates = { en: '/tags/', ko: '/ko/tags/' };
const topicRows = topics.map((topic) => ({ topic, count: getPostsForTopic(posts, topic.slug).length }));
---

<BaseLayout
  title="주제"
  ogTitle="Topics — Gemini Kim"
  description="일회성 태그 대신 오래 유지되는 주제로 Gemini Kim의 소프트웨어 엔지니어링 글을 둘러보세요."
  locale="ko"
  alternates={alternates}
>
  <header class="page-header page-shell">
    <p class="section-kicker">Explore</p>
    <h1>주제</h1>
    <p>아키텍처와 운영, 배포, 엔지니어링 실천을 오래 유지되는 주제로 정리했습니다.</p>
  </header>
  <section class="topic-index page-shell" aria-label="글 주제">
    <ol>
      {topicRows.map(({ topic, count }) => (
        <li>
          <a class="topic-card" href={`/ko/tags/${topic.slug}/`}>
            <span>
              <strong>{topic.label.ko}</strong>
              <small>{count}개 글</small>
            </span>
            <p>{topic.description.ko}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
