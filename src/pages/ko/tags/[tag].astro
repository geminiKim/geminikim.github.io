---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { topics } from '../../../data/tag-taxonomy.mjs';
import { formatDate } from '../../../lib/date';
import { getPostsForTopic, getPostUrl, getVisiblePosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getVisiblePosts('ko');
  return topics.map((topic) => ({
    params: { tag: topic.slug },
    props: { topic, posts: getPostsForTopic(posts, topic.slug) },
  }));
}

interface Props {
  topic: (typeof topics)[number];
  posts: CollectionEntry<'blog'>[];
}

const { topic, posts } = Astro.props;
const alternates = { en: `/tags/${topic.slug}/`, ko: `/ko/tags/${topic.slug}/` };
---

<BaseLayout
  title={topic.label.ko}
  ogTitle={`${topic.label.en} — Gemini Kim`}
  description={topic.description.ko}
  locale="ko"
  alternates={alternates}
>
  <header class="page-header page-shell">
    <a class="back-link" href="/ko/tags/"><span aria-hidden="true">←</span> 모든 주제</a>
    <p class="section-kicker">Topic</p>
    <h1>{topic.label.ko}</h1>
    <p>{topic.description.ko}</p>
  </header>
  <section class="topic-archive page-shell" aria-label={`${topic.label.ko} 글`}>
    <ol>
      {posts.map((post) => (
        <li>
          <a class="topic-article-link" href={getPostUrl(post)}>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, 'ko')}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
